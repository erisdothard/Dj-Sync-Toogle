// Copy to Config/Secrets.xcconfig (gitignored) and fill in.

// Your Apple developer Team ID (Xcode > Settings > Accounts).
DEVELOPMENT_TEAM =

// Optional default Spotify client ID baked into the build. Users can also paste their own in the app.
// Create one at developer.spotify.com/dashboard with redirect URI djsynctoggle://spotify-callback
SPOTIFY_CLIENT_ID = YOUR_SPOTIFY_CLIENT_ID

// Optional. A YouTube Data API v3 key (restricted to this iOS bundle ID in Google Cloud).
YOUTUBE_API_KEY =
